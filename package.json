{
  "name": "youtube-music-addon",
  "version": "1.0.0",
  "description": "YouTube Music addon for Eclipse with type-specific search fan-out via Piped API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/platforms/node-server.js",
    "start:legacy": "node dist/platforms/server.js",
    "dev": "ts-node src/platforms/node-server.ts",
    "dev:legacy": "ts-node src/platforms/server.ts",
    "build:worker": "wrangler deploy --dry-run --outdir=dist-worker",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist dist-worker"
  },
  "keywords": [
    "youtube-music",
    "piped",
    "eclipse",
    "music-addon"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.27.0",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.16"
  }
}
